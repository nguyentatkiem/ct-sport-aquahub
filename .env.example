# Chuỗi kết nối Postgres (Neon/Vercel Postgres dùng ?sslmode=require)
DATABASE_URL=postgres://user:pass@localhost:5432/ctsport_dev
# Chuỗi bí mật ký phiên đăng nhập, tối thiểu 32 ký tự ngẫu nhiên
AUTH_SECRET=
# Mật khẩu tài khoản Chủ khi chạy seed lần đầu (bắt buộc đổi sau khi đăng nhập)
SEED_OWNER_PASSWORD=
